# サーバーが待ち受けるホスト（全てのネットワークインターフェースで待ち受ける場合は 0.0.0.0）
HOST=0.0.0.0
# サーバーが待ち受けるポート番号
PORT=3000

# ブラウザ（クライアント）がWebSocketサーバーに接続する際のURL
# NEXT_PUBLIC_ プレフィックスが付いた変数はビルド時にブラウザへ埋め込まれます
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# Raspberry Pi PicoとのUSBシリアル接続設定
# 空にすると、PicoのUSBベンダーID(2e8a)から自動検出を試みます
# 自動検出できない/複数台接続する場合は、デバイスマネージャーで確認したCOMポート名を指定してください（例: COM3）
PICO_SERIAL_PORT=
PICO_SERIAL_BAUD=115200

# テスト用デバッグログ
# true にすると、Raspberry Pi Picoから届くログ(print出力)と送信内容を全てコンソールに表示します
DEBUG=false
